ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [Alignment-basedView]'),'2;1');
FILE_NAME('alignment.ifc','2026-10-11T00:00:00',(''),(''),'','hand-written','');
FILE_SCHEMA(('IFC4X3_ADD2'));
ENDSEC;

DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#3=IFCUNITASSIGNMENT((#1,#2));
#4=IFCCARTESIANPOINT((0.,0.,0.));
#5=IFCAXIS2PLACEMENT3D(#4,$,$);
#6=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#5,$);
#7=IFCPROJECT('0Project00000000000000',$,'Alignment',$,$,$,$,(#6),#3);
#8=IFCLOCALPLACEMENT($,#5);
#9=IFCSITE('0Site00000000000000000',$,'Site',$,$,#8,$,$,.ELEMENT.,$,$,$,$,$);

/* One alignment: a line, an arc to the left and a clothoid back to straight,
   over a constant gradient and a parabolic crest. */
#20=IFCALIGNMENT('0Alignment000000000000',$,'A1',$,$,#8,$,$);
#21=IFCALIGNMENTHORIZONTAL('0Horizontal00000000000',$,$,$,$,#8,$);
#22=IFCALIGNMENTVERTICAL('0Vertical0000000000000',$,$,$,$,#8,$);
#23=IFCRELNESTS('0NestsLayouts000000000',$,$,$,#20,(#21,#22));
#24=IFCRELAGGREGATES('0Aggregates00000000000',$,$,$,#7,(#9,#20,#50));

#30=IFCCARTESIANPOINT((0.,0.));
#31=IFCALIGNMENTHORIZONTALSEGMENT($,$,#30,0.,0.,0.,50.,$,.LINE.);
#32=IFCALIGNMENTSEGMENT('0SegmentH1000000000000',$,$,$,$,#8,$,#31);
#33=IFCCARTESIANPOINT((50.,0.));
#34=IFCALIGNMENTHORIZONTALSEGMENT($,$,#33,0.,100.,100.,40.,$,.CIRCULARARC.);
#35=IFCALIGNMENTSEGMENT('0SegmentH2000000000000',$,$,$,$,#8,$,#34);
#36=IFCCARTESIANPOINT((88.941834,7.893901));
#37=IFCALIGNMENTHORIZONTALSEGMENT($,$,#36,0.4,100.,0.,30.,$,.CLOTHOID.);
#38=IFCALIGNMENTSEGMENT('0SegmentH3000000000000',$,$,$,$,#8,$,#37);
#39=IFCRELNESTS('0NestsHorizontal000000',$,$,$,#21,(#32,#35,#38));

#40=IFCALIGNMENTVERTICALSEGMENT($,$,0.,60.,10.,0.02,0.02,$,.CONSTANTGRADIENT.);
#41=IFCALIGNMENTSEGMENT('0SegmentV1000000000000',$,$,$,$,#8,$,#40);
#42=IFCALIGNMENTVERTICALSEGMENT($,$,60.,60.,11.2,0.02,-0.01,-2000.,.PARABOLICARC.);
#43=IFCALIGNMENTSEGMENT('0SegmentV2000000000000',$,$,$,$,#8,$,#42);
#44=IFCRELNESTS('0NestsVertical00000000',$,$,$,#22,(#41,#43));

/* A second, shorter one, so that a file holds more than one: a line into an
   arc to the right, on a single gradient. */
#50=IFCALIGNMENT('0Alignment200000000000',$,'A2',$,$,#8,$,$);
#51=IFCALIGNMENTHORIZONTAL('0Horizontal20000000000',$,$,$,$,#8,$);
#52=IFCALIGNMENTVERTICAL('0Vertical2000000000000',$,$,$,$,#8,$);
#53=IFCRELNESTS('0NestsLayouts200000000',$,$,$,#50,(#51,#52));

#60=IFCCARTESIANPOINT((0.,20.));
#61=IFCALIGNMENTHORIZONTALSEGMENT($,$,#60,0.,0.,0.,30.,$,.LINE.);
#62=IFCALIGNMENTSEGMENT('0Segment2H100000000000',$,$,$,$,#8,$,#61);
#63=IFCCARTESIANPOINT((30.,20.));
#64=IFCALIGNMENTHORIZONTALSEGMENT($,$,#63,0.,-80.,-80.,20.,$,.CIRCULARARC.);
#65=IFCALIGNMENTSEGMENT('0Segment2H200000000000',$,$,$,$,#8,$,#64);
#66=IFCRELNESTS('0NestsHorizontal200000',$,$,$,#51,(#62,#65));

#70=IFCALIGNMENTVERTICALSEGMENT($,$,0.,50.,5.,-0.01,-0.01,$,.CONSTANTGRADIENT.);
#71=IFCALIGNMENTSEGMENT('0Segment2V100000000000',$,$,$,$,#8,$,#70);
#72=IFCRELNESTS('0NestsVertical20000000',$,$,$,#52,(#71));
ENDSEC;
END-ISO-10303-21;
